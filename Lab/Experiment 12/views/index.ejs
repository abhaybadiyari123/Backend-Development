<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title %></title>

    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <div class="container">

        <h1><%= title %></h1>

        <h2>Student List</h2>

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Age</th>
                    <th>Course</th>
                </tr>
            </thead>

            <tbody>
                <% students.forEach(student => { %>
                    <tr>
                        <td><%= student.id %></td>
                        <td><%= student.name %></td>
                        <td><%= student.age %></td>
                        <td><%= student.course %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>

        <h2>Add Student</h2>

        <form action="/student" method="POST">
            <label>Name:</label>
            <input type="text" name="name" required>

            <label>Age:</label>
            <input type="number" name="age" required>

            <label>Course:</label>
            <input type="text" name="course" required>

            <button type="submit">Submit</button>
        </form>

    </div>

</body>
</html>